{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "operational-manpower-roster",
    "version": "1.0.0",
    "description": "Operational Manpower Roster Desktop Application",
    "private": true,
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "electron": "electron .",
        "electron:dev": "node electron/dev-runner.cjs",
        "dist": "npm run build && electron-builder --win"
    },
    "build": {
        "appId": "com.company.operationalmanpowerroster",
        "productName": "Operational Manpower Roster",
        "asar": false,
        "directories": {
            "output": "dist"
        },
        "win": {
            "target": [
                "nsis"
            ]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        },
        "files": [
            "app/**/*",
            "bootstrap/**/*",
            "config/**/*",
            "database/**/*",
            "public/**/*",
            "resources/views/**/*",
            "routes/**/*",
            "storage/**/*",
            "vendor/**/*",
            "artisan",
            ".env",
            ".env.example",
            "electron/**/*",
            "!electron/bin/php/**/*",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "electron/bin/php",
                "to": "php",
                "filter": [
                    "**/*"
                ]
            }
        ]
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "daisyui": "^5.7.50",
        "electron": "^45.2.1",
        "electron-builder": "^26.18.0",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
